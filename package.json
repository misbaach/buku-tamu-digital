{
  "name": "buku-tamu-digital",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "gitleaks": "node scripts/gitleaks.mjs",
    "secrets:scan": "node scripts/gitleaks.mjs git --redact --no-banner",
    "typecheck": "tsc -p packages/shared && tsc -p tests",
    "test:unit": "vitest run --project shared --project repo --project dashboard",
    "test:integration": "vitest run --project integration",
    "db:start": "node scripts/local-secrets.mjs --env && supabase start && node scripts/local-secrets.mjs --vault",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/local-secrets.mjs --vault",
    "db:test": "supabase test db",
    "db:types": "node scripts/gen-db-types.mjs",
    "functions:sync": "node scripts/sync-shared-to-functions.mjs",
    "sim": "node scripts/simulate-checkins.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@guestbook/shared": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "lefthook": "2.2.1",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "supabase": "2.120.0",
    "svelte": "5.57.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
