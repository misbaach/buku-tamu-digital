{
  "name": "@guestbook/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/local-supabase-env.mjs -- vite dev --host 127.0.0.1",
    "build": "vite build",
    "build:local": "node ../../scripts/local-supabase-env.mjs -- vite build",
    "preview:pages": "wrangler pages dev build --port 8788 --ip 127.0.0.1 --compatibility-date=2026-10-06",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "node ../../scripts/local-supabase-env.mjs -- playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@guestbook/shared": "workspace:*",
    "@supabase/supabase-js": "2.117.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
