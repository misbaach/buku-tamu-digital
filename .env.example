# Templat variabel lingkungan untuk build produksi dashboard.
# Hanya boleh berisi placeholder berbentuk NAMA=<NAMA> atau NAMA= (dicek tests/repo/env-example.test.ts).
# Pengembangan lokal tidak memakai file ini: nilai dibaca langsung dari `supabase status`.
PUBLIC_SUPABASE_URL=<PUBLIC_SUPABASE_URL>
PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLIC_SUPABASE_PUBLISHABLE_KEY>
